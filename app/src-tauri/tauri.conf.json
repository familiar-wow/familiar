{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Familiar",
	"mainBinaryName": "Familiar",
	"version": "../package.json",
	"identifier": "io.github.familiar-wow.familiar",
	"build": {
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist",
		"beforeDevCommand": "bun run sidecar && bun run dev",
		"beforeBuildCommand": "bun run sidecar && bun run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Familiar",
				"url": "index.html",
				"width": 1100,
				"height": 720,
				"minWidth": 860,
				"minHeight": 560,
				"center": true,
				"backgroundColor": "#0d0f14"
			},
			{
				"label": "tray",
				"title": "Familiar",
				"url": "tray.html",
				"width": 340,
				"height": 400,
				"visible": false,
				"decorations": false,
				"resizable": false,
				"skipTaskbar": true,
				"alwaysOnTop": true,
				"backgroundColor": "#141820"
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "deb", "appimage"],
		"publisher": "Familiar contributors",
		"copyright": "MIT License, Familiar contributors",
		"category": "Game",
		"shortDescription": "An AI companion for World of Warcraft",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/familiar-core"],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"languages": ["English", "German"],
				"displayLanguageSelector": false
			}
		}
	}
}
